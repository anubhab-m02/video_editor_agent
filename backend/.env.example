GEMINI_API_KEY=your_google_ai_studio_key
# Shared secret required as the X-API-Key header on all endpoints except /health and /media/*.
# Leave blank to disable auth for local dev. Set this before exposing the backend publicly.
API_KEY=
MEDIA_ROOT=../media
MAX_FILE_SIZE_MB=500
MAX_VIDEO_DURATION_SEC=10
# Rendered outputs older than this are deleted on the next export call. 0 disables cleanup.
OUTPUT_TTL_MIN=60
SPRITE_PERSIST=false
CORS_ORIGINS=http://localhost:3000
# Example: https://your-frontend.vercel.app
VERCEL_FRONTEND_URL=
